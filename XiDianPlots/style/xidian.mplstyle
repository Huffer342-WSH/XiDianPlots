# =========================================================================
# Xidian University Master's Thesis Style
# =========================================================================
# 基础规范: A4纸张, 单列排版, 5号字(10.5pt), Times New Roman(英)+宋体(中)

# -------------------------------------------------------------------------
# 1. Figure Size & Layout
# -------------------------------------------------------------------------
figure.figsize : 5.8, 3.58  # A4内容区宽度约160mm，高度2.8英寸
figure.dpi : 96             # 屏幕显示DPI，保存时建议dpi=600
savefig.bbox : tight        # 自动裁剪白边

# -------------------------------------------------------------------------
# 2. Colors
# -------------------------------------------------------------------------
# 配色顺序: 蓝, 橙, 黄, 紫, 绿, 青, 红
axes.prop_cycle : cycler('color', ['0072BD', 'D95319', 'EDB120', '7E2F8E', '77AC30', '4DBEEE', 'A2142F'])

# -------------------------------------------------------------------------
# 3. Fonts
# -------------------------------------------------------------------------
font.size : 10.5            # 5号字标准
axes.labelsize : 10.5
xtick.labelsize : 10.5
ytick.labelsize : 10.5
legend.fontsize : 10.5
figure.titlesize : 10.5
axes.titlesize : 10.5
axes.titleweight : normal

font.family : serif         # 衬线字体
font.serif : RomanSong, TeX Gyre Termes, Noto Serif CJK SC, Times New Roman, SimSun, serif

mathtext.fontset : dejavuserif  # 数学字体
axes.unicode_minus : False      # 修正负号显示
text.usetex : False             # 禁用TeX渲染

# -------------------------------------------------------------------------
# 4. Axis & Ticks
# -------------------------------------------------------------------------
xtick.direction : in            # 刻度线朝内
ytick.direction : in
xtick.top : True                # 显示顶部刻度
ytick.right : True              # 显示右侧刻度

# 主刻度设置
xtick.major.size : 3
xtick.major.width : 0.5
ytick.major.size : 3
ytick.major.width : 0.5

# 次刻度设置
xtick.minor.visible : True
xtick.minor.size : 1.5
xtick.minor.width : 0.5
ytick.minor.visible : True
ytick.minor.size : 1.5
ytick.minor.width : 0.5

# -------------------------------------------------------------------------
# 5. Lines & Grid
# -------------------------------------------------------------------------
axes.linewidth : 0.8            # 坐标轴线宽
grid.linewidth : 0.5            # 网格线宽
grid.alpha : 0.3                # 网格透明度
lines.linewidth : 1.2           # 曲线线宽
lines.markersize : 6            # 标记大小

# -------------------------------------------------------------------------
# 6. Legend
# -------------------------------------------------------------------------
legend.frameon : False          # 无边框
legend.labelspacing : 1.0       # 行间距

# -------------------------------------------------------------------------
# 7. PGF Backend Configuration (LaTeX导出)
# -------------------------------------------------------------------------
pgf.texsystem : xelatex         # 使用xelatex引擎
pgf.rcfonts : False             # 禁用内部字体转换
# PGF导言区: 数学包、xeCJK、字体设置
pgf.preamble : \usepackage{amsmath} \usepackage{amssymb} \usepackage{xeCJK} \usepackage{siunitx} \setmainfont{Times New Roman} \setCJKmainfont{SimSun}
